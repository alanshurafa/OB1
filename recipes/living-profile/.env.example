# Living Profile recipe: environment variables
#
# Copy this file to `.env.local` (already gitignored by the repo root .gitignore)
# and fill in real values. The scripts load this file relative to their own
# working directory, then fall back to process.env.
#
# Constraints: UPPER_SNAKE_CASE keys, single-line values. process.env wins if
# both are set.

# --- Required ---
OPEN_BRAIN_URL=https://YOUR_REF.supabase.co
OPEN_BRAIN_SERVICE_KEY=your-service-role-key-placeholder

# Default LLM provider. Any OpenAI-compatible Chat Completions endpoint works:
# OpenRouter, OpenAI direct, Anthropic via OpenRouter, or a local Ollama/LM
# Studio server. Used for distillation, near-duplicate adjudication, and the
# profile summary prose.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=your-openrouter-key-placeholder
LLM_MODEL=anthropic/claude-haiku-4-5

# Required by synthesize-profile.mjs (not seed-profile.mjs) for
# text-embedding-3-small calls in the daily loop's near-duplicate reconcile
# step — independent of whichever LLM_* provider you picked above. Not
# required in --dry-run mode.
OPENAI_API_KEY=your-openai-key-placeholder

# Your name, used in the profile header and in the distillation prompt so the
# LLM knows whose facts it's extracting.
SUBJECT_NAME=YourFirstName

# Comma-separated names/aliases the synthesizer treats as "you" when resolving
# self-speech in wearable or transcript-style thoughts (e.g. "who said this").
SELF_LABELS=YourFirstName,Your Full Name

# --- Optional ---
# Your row id in the `entities` table, if you run the Knowledge Graph schema.
# Leave unset on baseline OB1; the recipe works without it (facts still get
# written and rendered — you just don't get an entity_id link on the page).
# SELF_ENTITY_ID=

# The id of an existing single-blob profile/bio thought to split into facts
# during `seed-profile.mjs --from-canonical`. Only read by the seed script;
# you can pass --thought-id=NNNN on the command line instead. Leave unset if
# you're only seeding from --from-omi-memories, or have no such thought yet.
# CANONICAL_PROFILE_THOUGHT_ID=

# Override the default category taxonomy (comma-separated). Leave unset to use
# the built-in eight: identity-family, relationships, work-projects,
# health-routines, preferences-workflow, values-beliefs, skills-tools,
# context-places. Order matters: the FIRST category is treated as the
# "identity-core" category (gets importance=5 instead of 4 on written facts).
# PROFILE_CATEGORIES=

# Max candidate thoughts scanned per synthesis run. Keep this bounded so a
# scheduled task doesn't run past its time limit on a large brain.
# PROFILE_RUN_CAP=300

# Override the state-file path (and its lockfile). Used to isolate a
# probe/test run from a scheduled run's watermark and lock — you likely never
# need to set this by hand.
# PROFILE_STATE_FILE=./data/profile-synthesis-state.json
